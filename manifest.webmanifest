{
  "id": "./",
  "name": "Quectel 天線選型工具",
  "short_name": "天線選型",
  "description": "Quectel 天線產品選型：Global 與日本市場，可離線使用",
  "lang": "zh-Hant-TW",
  "dir": "ltr",
  "start_url": "./index.html#/global",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F2F4F3",
  "theme_color": "#0F766E",
  "categories": ["business", "productivity", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshot-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Global 天線選型" },
    { "src": "screenshot-narrow.png", "sizes": "540x1170", "type": "image/png", "form_factor": "narrow", "label": "日本市場天線選型" }
  ],
  "shortcuts": [
    { "name": "Global", "short_name": "Global", "url": "./index.html#/global", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "日本市場", "short_name": "日本", "url": "./index.html#/japan", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
